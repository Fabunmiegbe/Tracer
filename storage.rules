rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Layout: receipts/<uid>/<deviceId>/<file>  and  reports/<uid>/<deviceId>/<file>
    match /{kind}/{uid}/{deviceId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid && kind in ['receipts', 'reports'];
      // Users upload receipts only; reports are written by Cloud Functions.
      allow create, update: if request.auth != null && request.auth.uid == uid && kind == 'receipts'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid && kind == 'receipts';
    }
  }
}
